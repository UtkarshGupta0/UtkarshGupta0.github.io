# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bits_ratings

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=replace_me_with_long_random_secret
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example
SMTP_PASS=example
SMTP_FROM="BITS Ratings <no-reply@example.com>"

# Allowed email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=pilani.bits-pilani.ac.in,goa.bits-pilani.ac.in,hyderabad.bits-pilani.ac.in,dubai.bits-pilani.ac.in